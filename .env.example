# SETUP: cp .env.example .env
# FILL:  Every [REPLACE] value before running
# NEVER: Commit the .env file
# =====================================================

NODE_ENV=development
JWT_SECRET=REPLACE-min-32-char-random-string
JWT_EXPIRES_IN=15m
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smart_hospital
DB_USER=hospital_admin
DB_PASSWORD=REPLACE-secure-password
REDIS_URL=redis://redis:6379
AI_SERVICE_URL=http://ai-services:8000
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

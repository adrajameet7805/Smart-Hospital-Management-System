# =====================================================
# Smart Hospital Management System — Environment
# Author: Meet Adraja
# =====================================================
# SETUP:  cp .env.example .env
# FILL:   Every value marked [REPLACE] before running
# NEVER:  Commit the .env file (it is in .gitignore)
# =====================================================

# ── Application ───────────────────────────────────────
NODE_ENV=development

# ── JWT Authentication ────────────────────────────────
# Generate secure value: openssl rand -hex 32
JWT_SECRET=[REPLACE-WITH-SECURE-RANDOM-STRING-MIN-32-CHARS]
JWT_EXPIRES_IN=15m

# ── PostgreSQL Database ───────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smart_hospital
DB_USER=hospital_admin
DB_PASSWORD=[REPLACE-WITH-SECURE-DATABASE-PASSWORD]

# ── Redis Cache ───────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── AI Microservice (Docker internal DNS) ─────────────
AI_SERVICE_URL=http://ai-services:8000

# ── CORS (comma-separated allowed frontend origins) ───
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# ── Production only ───────────────────────────────────
# GRAFANA_PASSWORD=[REPLACE-WITH-GRAFANA-ADMIN-PASSWORD]
# SSL domain for certbot:
# DOMAIN=yourhospital.com

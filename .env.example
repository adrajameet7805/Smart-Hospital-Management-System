# ================================================
# Smart Hospital Management System — Environment
# Copy this file: cp .env.example .env
# Fill in all values before running docker-compose
# ================================================

# Node Environment
NODE_ENV=development

# JWT Authentication
JWT_SECRET=replace-with-your-secret-min-32-characters
JWT_EXPIRES_IN=15m

# PostgreSQL Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smart_hospital
DB_USER=hospital_admin
DB_PASSWORD=replace-with-your-secure-password

# Redis
REDIS_URL=redis://redis:6379

# AI Service (internal Docker DNS)
AI_SERVICE_URL=http://ai-services:8000

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

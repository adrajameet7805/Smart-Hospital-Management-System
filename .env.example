# =====================================================
# Smart Hospital Management System — Environment
# =====================================================
# SETUP: cp .env.example .env
# Fill ALL values before running docker-compose up
# NEVER commit the .env file (it is in .gitignore)
# =====================================================

# ── App ───────────────────────────────────────────
NODE_ENV=development

# ── JWT Auth ──────────────────────────────────────
# Min 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-secure-random-secret
JWT_EXPIRES_IN=15m

# ── PostgreSQL ────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smart_hospital
DB_USER=hospital_admin
DB_PASSWORD=replace-this-with-a-secure-password

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── AI Service (Docker internal DNS) ──────────────
AI_SERVICE_URL=http://ai-services:8000

# ── CORS (comma-separated allowed origins) ────────
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# ── Production only ───────────────────────────────
# GRAFANA_PASSWORD=replace-this-too
